{"updatedAt": "2026-08-01T20:27:32.125Z", "createdAt": "2026-08-01T01:34:51.228Z", "id": "m0x2ZvGzrFSCvPBA", "name": "ZAPIER \u2014 Hermes Bridge (CI/CD, Webhook, API)", "description": null, "active": false, "isArchived": false, "nodes": [{"parameters": {"httpMethod": "POST", "path": "zapier-bridge", "responseMode": "responseNode", "options": {}}, "id": "zapier-webhook-trigger", "name": "Zapier Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [250, 300]}, {"parameters": {"jsCode": "// Parse Zapier payload and normalize for routing\nconst payload = $input.item.json;\n\n// Extract common Zapier fields\nconst event = payload.body || payload;\nconst source = payload.headers?.['x-zapier-source'] || 'zapier';\nconst eventType = payload.headers?.['x-zapier-event'] || event.event || 'generic';\n\n// Parse body if it's a string\nlet data = event;\nif (typeof event === 'string') {\n  try { data = JSON.parse(event); } catch(e) { data = { raw: event }; }\n}\n\n// Normalize into standard shape\nreturn [{\n  json: {\n    source: source,\n    event_type: eventType,\n    timestamp: new Date().toISOString(),\n    payload: data,\n    routing_key: `${source}:${eventType}`\n  }\n}];"}, "id": "zapier-parser", "name": "Parse Zapier Payload", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [500, 300]}, {"parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"}, "conditions": [{"id": "ci-cd", "leftValue": "={{ $json.routing_key }}", "rightValue": "github:push", "operator": {"type": "string", "operation": "contains"}}], "combinator": "or"}}, "id": "zapier-router", "name": "Route by Event", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [750, 300]}, {"parameters": {"url": "http://127.0.0.1:8642/api/v1/messages", "authentication": "none", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Content-Type", "value": "application/json"}, {"name": "X-Zapier-Bridge", "value": "n8n-zapier-bridge-v1"}]}, "sendBody": true, "bodyParameters": {"parameters": []}, "specifyBody": "json", "jsonBody": "{\n  \"text\": \"\ud83d\udd14 Zapier Event: {{ $json.event_type }}\\nSource: {{ $json.source }}\\nPayload: {{ JSON.stringify($json.payload) }}\",\n  \"source\": \"zapier-bridge\",\n  \"event_type\": \"{{ $json.event_type }}\"\n}", "options": {}}, "id": "hermes-notify", "name": "Forward to Hermes", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1000, 250]}, {"parameters": {"url": "http://127.0.0.1:8642/api/v1/messages", "authentication": "none", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Content-Type", "value": "application/json"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "{\n  \"text\": \"\ud83d\udd04 CI/CD: {{ $json.event_type }} on {{ $json.payload.repository }}\\nBranch: {{ $json.payload.branch }} | Commit: {{ $json.payload.commit }}\\nAction: {{ $json.payload.action }}\\n\\nRunning Hermes CI checks...\",\n  \"source\": \"ci-pipeline\",\n  \"event_type\": \"ci-cd\"\n}", "options": {}}, "id": "ci-notify", "name": "CI/CD Notification", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1000, 450]}, {"parameters": {"respondWith": "json", "responseBody": "={\n  \"status\": \"received\",\n  \"event_type\": \"{{ $json.event_type }}\",\n  \"routing_key\": \"{{ $json.routing_key }}\",\n  \"timestamp\": \"{{ $json.timestamp }}\",\n  \"bridge\": \"n8n-zapier-bridge-v1\"\n}", "options": {}}, "id": "respond-webhook", "name": "Respond to Zapier", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [1000, 600]}], "connections": {"Zapier Webhook": {"main": [[{"node": "Parse Zapier Payload", "type": "main", "index": 0}]]}, "Parse Zapier Payload": {"main": [[{"node": "Route by Event", "type": "main", "index": 0}]]}, "Route by Event": {"main": [[{"node": "CI/CD Notification", "type": "main", "index": 0}], [{"node": "Forward to Hermes", "type": "main", "index": 0}]]}, "Forward to Hermes": {"main": [[{"node": "Respond to Zapier", "type": "main", "index": 0}]]}, "CI/CD Notification": {"main": [[{"node": "Respond to Zapier", "type": "main", "index": 0}]]}}, "settings": {"executionOrder": "v1", "callerPolicy": "workflowsFromSameOwner", "availableInMCP": true}, "staticData": null, "meta": null, "pinData": null, "versionId": "46503cd2-b485-45d2-a8d1-50fa6bbf4adf", "activeVersionId": null, "versionCounter": 2, "triggerCount": 0, "shared": [{"updatedAt": "2026-08-01T01:34:51.228Z", "createdAt": "2026-08-01T01:34:51.228Z", "role": "workflow:owner", "workflowId": "m0x2ZvGzrFSCvPBA", "projectId": "wI1MZESjf1ci46dZ", "project": {"updatedAt": "2025-09-26T11:09:32.827Z", "createdAt": "2025-09-26T10:27:30.749Z", "id": "wI1MZESjf1ci46dZ", "name": "Web Master <webmaster@clearwateraesthetics.com>", "type": "personal", "icon": null, "description": null, "creatorId": "cc65b1b6-5043-4d07-81dd-eeefb2f0d0a0"}}], "tags": [], "activeVersion": null}