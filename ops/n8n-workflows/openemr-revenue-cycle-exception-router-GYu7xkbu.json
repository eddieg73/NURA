{"updatedAt": "2026-08-01T20:29:11.146Z", "createdAt": "2026-07-27T01:43:19.671Z", "id": "GYu7xkbuQNQBIYdD", "name": "OpenEMR \u2014 Revenue Cycle Exception Router", "description": null, "active": false, "isArchived": false, "nodes": [{"name": "Billing Exception Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2.1, "position": [240, 460], "parameters": {"httpMethod": "POST", "path": "openemr-billing-exception", "responseMode": "responseNode", "options": {}}, "id": "68308e30-652e-467e-ae66-9955a68268ab"}, {"name": "Normalize Billing Event", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [460, 460], "parameters": {"jsCode": "const b = $json.body || $json;\nconst claimId = String(b.claim_id || b.claimId || b.id || '').trim();\nconst patientId = String(b.patient_id || b.patientId || '').trim();\nconst encounterId = String(b.encounter_id || b.encounterId || '').trim();\nconst status = String(b.status || b.claim_status || 'exception').trim();\nconst reason = String(b.reason || b.error || b.message || 'Billing exception').trim();\nconst payer = String(b.payer || b.insurer || '').trim();\nconst severity = /denied|urgent|critical/i.test(reason) ? 'high' : 'normal';\nconst ok = Boolean(claimId && patientId);\nreturn [{ json: { ok, claimId, patientId, encounterId, status, reason, payer, severity, baseUrl: ($env.OPENEMR_BASE_URL || 'https://emr.hrthouse.com').replace(/\\/$/, ''), siteId: $env.OPENEMR_SITE_ID || 'default', token: $env.OPENEMR_ACCESS_TOKEN || '', billingWebhook: $env.BILLING_QUEUE_WEBHOOK_URL || '', auditWebhook: $env.AUDIT_WEBHOOK_URL || '' } }];"}, "id": "05006a6f-fbc9-4a46-9bb2-40784b6d4364"}, {"name": "Billing Event Valid?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [680, 460], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"}, "conditions": [{"id": "c1", "leftValue": "={{ $json.ok }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}}, "id": "505919cb-83c3-42ab-979d-4dab2b1f95dd"}, {"name": "Fetch Patient Context", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [900, 340], "parameters": {"method": "GET", "url": "={{ $json.baseUrl + '/apis/' + $json.siteId + '/fhir/Patient/' + encodeURIComponent($json.patientId) }}", "authentication": "none", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Accept", "value": "application/fhir+json"}, {"name": "Content-Type", "value": "application/fhir+json"}, {"name": "Authorization", "value": "={{ 'Bearer ' + $json.token }}"}]}, "options": {}}, "id": "e0ffc125-ad31-4529-912a-cb2862454603"}, {"name": "Assess Billing Exception", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1120, 340], "parameters": {"jsCode": "const ctx = $('Normalize Billing Event').item.json;\nconst patient = $json || {};\nconst humanName = Array.isArray(patient.name) && patient.name.length ? [patient.name[0]?.given?.join(' '), patient.name[0]?.family].filter(Boolean).join(' ').trim() : ctx.patientId;\nreturn [{ json: { ...ctx, patient_name: humanName, exception_summary: `Billing exception for ${humanName} / claim ${ctx.claimId}: ${ctx.reason}`, billingWebhook: ctx.billingWebhook, auditWebhook: ctx.auditWebhook } }];"}, "id": "495973a7-54bc-4a19-9987-8dd630730983"}, {"name": "Send Billing Queue Notification", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [1340, 340], "parameters": {"method": "POST", "url": "={{ $json.billingWebhook }}", "authentication": "none", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ channel: 'billing-exception', claim_id: $json.claimId, patient_id: $json.patientId, patient_name: $json.patient_name, encounter_id: $json.encounterId, severity: $json.severity, status: $json.status, reason: $json.reason, payer: $json.payer, summary: $json.exception_summary }) }}", "options": {}}, "id": "6c08c77a-9636-4311-bd26-110d4fecf3f5"}, {"name": "Audit Billing Exception", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [1560, 340], "parameters": {"method": "POST", "url": "={{ $json.auditWebhook }}", "authentication": "none", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ workflow: 'OpenEMR \u2014 Revenue Cycle Exception Router', claim_id: $json.claimId, patient_id: $json.patientId, severity: $json.severity, status: 'routed' }) }}", "options": {}}, "id": "6da6c2ae-a8d4-4fa2-acba-ee329119972a"}, {"name": "Respond Billing Routed", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [1780, 340], "parameters": {"respondWith": "json", "responseBody": "={{ JSON.stringify($json) }}", "options": {"responseHeaders": {"entries": [{"name": "Content-Type", "value": "application/json"}]}}}, "id": "4d88eb35-c736-489d-b25f-e7a8e0e4316e"}, {"name": "Invalid Billing Event", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [900, 620], "parameters": {"jsCode": "return [{ json: { ok: false, status: 'invalid_request', message: 'Need claim_id and patient_id at minimum.' } }];"}, "id": "f4f599c2-3c85-4bbb-82ca-226c233c0739"}, {"name": "Respond Invalid Billing", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [1120, 620], "parameters": {"respondWith": "json", "responseBody": "={{ JSON.stringify($json) }}", "options": {"responseHeaders": {"entries": [{"name": "Content-Type", "value": "application/json"}]}}}, "id": "67272850-a8f5-4a15-bcff-470fbdb2e505"}], "connections": {"Billing Exception Webhook": {"main": [[{"node": "Normalize Billing Event", "type": "main", "index": 0}]]}, "Normalize Billing Event": {"main": [[{"node": "Billing Event Valid?", "type": "main", "index": 0}]]}, "Billing Event Valid?": {"main": [[{"node": "Fetch Patient Context", "type": "main", "index": 0}], [{"node": "Invalid Billing Event", "type": "main", "index": 0}]]}, "Fetch Patient Context": {"main": [[{"node": "Assess Billing Exception", "type": "main", "index": 0}]]}, "Assess Billing Exception": {"main": [[{"node": "Send Billing Queue Notification", "type": "main", "index": 0}]]}, "Send Billing Queue Notification": {"main": [[{"node": "Audit Billing Exception", "type": "main", "index": 0}]]}, "Audit Billing Exception": {"main": [[{"node": "Respond Billing Routed", "type": "main", "index": 0}]]}, "Invalid Billing Event": {"main": [[{"node": "Respond Invalid Billing", "type": "main", "index": 0}]]}}, "settings": {"callerPolicy": "workflowsFromSameOwner", "availableInMCP": true}, "staticData": null, "meta": null, "pinData": null, "versionId": "56260630-df66-4182-b522-20456b87ee37", "activeVersionId": null, "versionCounter": 2, "triggerCount": 0, "shared": [{"updatedAt": "2026-07-27T01:43:19.671Z", "createdAt": "2026-07-27T01:43:19.671Z", "role": "workflow:owner", "workflowId": "GYu7xkbuQNQBIYdD", "projectId": "wI1MZESjf1ci46dZ", "project": {"updatedAt": "2025-09-26T11:09:32.827Z", "createdAt": "2025-09-26T10:27:30.749Z", "id": "wI1MZESjf1ci46dZ", "name": "Web Master <webmaster@clearwateraesthetics.com>", "type": "personal", "icon": null, "description": null, "creatorId": "cc65b1b6-5043-4d07-81dd-eeefb2f0d0a0"}}], "tags": [], "activeVersion": null}