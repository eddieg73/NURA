{"updatedAt": "2026-08-01T20:28:19.720Z", "createdAt": "2026-06-03T15:14:29.775Z", "id": "93b7VyQB35o5UFD9", "name": "Medisun Kreyol Test Page", "description": null, "active": true, "isArchived": false, "nodes": [{"parameters": {"httpMethod": "GET", "path": "medisun-kreyol-test", "responseMode": "responseNode", "options": {}}, "id": "node-page-webhook", "name": "GET /test", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [200, 200], "webhookId": "medisun-kreyol-test"}, {"parameters": {"respondWith": "text", "responseBody": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Medisun \u2014 Kreyol Voice AI Test</title>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body { font-family: system-ui, -apple-system, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n    .card { background: white; border-radius: 16px; padding: 40px 32px; max-width: 480px; width: 100%; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }\n    h1 { font-size: 24px; margin-bottom: 8px; color: #1a1a1a; }\n    .subtitle { color: #666; font-size: 14px; margin-bottom: 24px; line-height: 1.5; }\n    .flag { font-size: 32px; margin-bottom: 12px; }\n    .instructions { background: #f4f8ff; border-left: 4px solid #0070f3; padding: 14px 16px; border-radius: 4px; margin-bottom: 24px; font-size: 13px; color: #333; line-height: 1.6; }\n    .instructions strong { color: #0070f3; }\n    .instructions ol { margin: 6px 0 0 20px; }\n    button { width: 100%; padding: 16px; font-size: 16px; font-weight: 600; border: none; border-radius: 8px; cursor: pointer; transition: all 0.2s; margin-top: 8px; }\n    .btn-start { background: #27ae60; color: white; }\n    .btn-start:hover:not(:disabled) { background: #1f8a4d; transform: translateY(-1px); }\n    .btn-end { background: #e74c3c; color: white; display: none; }\n    .btn-end:hover { background: #c0392b; }\n    button:disabled { opacity: 0.5; cursor: not-allowed; }\n    .status { margin-top: 20px; padding: 12px; border-radius: 6px; font-size: 14px; text-align: center; min-height: 44px; display: flex; align-items: center; justify-content: center; }\n    .status.idle { background: #f5f5f5; color: #666; }\n    .status.connecting { background: #fff3cd; color: #856404; }\n    .status.connected { background: #d4edda; color: #155724; animation: pulse 2s infinite; }\n    .status.ended { background: #d1ecf1; color: #0c5460; }\n    .status.error { background: #f8d7da; color: #721c24; }\n    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.7; } }\n    .transcript { margin-top: 20px; background: #fafafa; border: 1px solid #eee; border-radius: 6px; padding: 12px; max-height: 280px; overflow-y: auto; font-size: 13px; line-height: 1.5; display: none; }\n    .transcript .turn { margin-bottom: 8px; padding: 6px 8px; border-radius: 4px; }\n    .transcript .agent { background: #e3f2fd; }\n    .transcript .user { background: #fff3e0; }\n    .transcript .role { font-weight: 600; font-size: 11px; opacity: 0.7; margin-bottom: 2px; }\n    .debug { margin-top: 16px; font-size: 11px; color: #888; background: #f8f8f8; padding: 8px 10px; border-radius: 4px; font-family: ui-monospace, monospace; max-height: 120px; overflow-y: auto; display: none; }\n    .debug.show { display: block; }\n    .footer { margin-top: 24px; padding-top: 16px; border-top: 1px solid #eee; font-size: 11px; color: #888; text-align: center; }\n  </style>\n</head>\n<body>\n  <div class=\"card\">\n    <div class=\"flag\">\ud83c\udded\ud83c\uddf9</div>\n    <h1>Medisun \u2014 Kreyol Voice AI Test</h1>\n    <p class=\"subtitle\">Real-time browser-based voice call with our Kreyol-speaking receptionist agent. Native Kreyol speakers \u2014 please test and report how it sounds.</p>\n\n    <div class=\"instructions\">\n      <strong>Instructions:</strong>\n      <ol>\n        <li>Use <strong>Chrome, Safari, or Edge</strong> (Firefox sometimes blocks mic)</li>\n        <li>When prompted, click <strong>\"Allow\"</strong> for microphone</li>\n        <li>Click <strong>Start Test Call</strong></li>\n        <li>The agent greets you in Kreyol and asks for your full name, phone, date of birth, and insurance plan</li>\n        <li>Respond naturally in Kreyol</li>\n        <li>Click <strong>End Call</strong> when done</li>\n      </ol>\n    </div>\n\n    <button id=\"btn-start\" class=\"btn-start\">\ud83c\udfa4 Start Test Call</button>\n    <button id=\"btn-end\" class=\"btn-end\">\u23f9 End Call</button>\n\n    <div id=\"status\" class=\"status idle\">Ready to test.</div>\n    <div id=\"transcript\" class=\"transcript\"></div>\n    <div id=\"debug\" class=\"debug\"></div>\n\n    <div class=\"footer\">Medisun internal testing \u2014 Kreyol intake</div>\n  </div>\n\n  <script type=\"module\">\n    const btnStart = document.getElementById('btn-start');\n    const btnEnd = document.getElementById('btn-end');\n    const statusEl = document.getElementById('status');\n    const transcriptEl = document.getElementById('transcript');\n    const debugEl = document.getElementById('debug');\n\n    let client = null;\n    let RetellWebClient = null;\n\n    function setStatus(text, cls) {\n      statusEl.textContent = text;\n      statusEl.className = 'status ' + cls;\n    }\n\n    function log(msg) {\n      console.log('[Medisun]', msg);\n      debugEl.classList.add('show');\n      const line = document.createElement('div');\n      line.textContent = '> ' + msg;\n      debugEl.appendChild(line);\n      debugEl.scrollTop = debugEl.scrollHeight;\n    }\n\n    function addTurn(role, text) {\n      transcriptEl.style.display = 'block';\n      const div = document.createElement('div');\n      div.className = 'turn ' + role;\n      div.innerHTML = '<div class=\"role\">' + (role === 'agent' ? '\ud83e\udd16 Agent' : '\ud83d\udc64 You') + '</div>' + text;\n      transcriptEl.appendChild(div);\n      transcriptEl.scrollTop = transcriptEl.scrollHeight;\n    }\n\n    // 1. Preload the SDK on page load (so it's ready when user clicks)\n    setStatus('Loading\u2026', 'connecting');\n    log('Loading Nura\u2026');\n    try {\n      const mod = await import('https://esm.sh/retell-client-js-sdk');\n      RetellWebClient = mod.RetellWebClient;\n      log('SDK loaded \u2713');\n      setStatus('Ready \u2014 click Start when you are.', 'idle');\n    } catch (e) {\n      log('SDK load failed: ' + e.message);\n      setStatus('SDK failed to load. Refresh the page.', 'error');\n    }\n\n    btnStart.onclick = async () => {\n      btnStart.disabled = true;\n\n      // 2. Browser support check\n      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {\n        setStatus('Your browser does not support microphone. Use Chrome, Safari, or Edge.', 'error');\n        btnStart.disabled = false;\n        return;\n      }\n      if (location.protocol !== 'https:' && location.hostname !== 'localhost') {\n        setStatus('Microphone requires HTTPS. Try opening this page over HTTPS.', 'error');\n        btnStart.disabled = false;\n        return;\n      }\n\n      // 3. Explicitly request mic permission BEFORE the SDK\n      setStatus('Requesting microphone permission\u2026', 'connecting');\n      log('Requesting microphone\u2026');\n      try {\n        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\n        log('Microphone granted \u2713');\n        stream.getTracks().forEach(t => t.stop()); // release; SDK will re-acquire\n      } catch (e) {\n        log('Mic denied: ' + e.name + ' \u2014 ' + e.message);\n        setStatus('Microphone permission denied. Click the \ud83c\udfa4 icon in the address bar to allow.', 'error');\n        btnStart.disabled = false;\n        return;\n      }\n\n      // 4. Get a Retell access token from our backend\n      setStatus('Creating call session\u2026', 'connecting');\n      log('Fetching access token from server\u2026');\n      let access_token;\n      try {\n        const resp = await fetch('/webhook/medisun-kreyol-test-start', { method: 'POST', headers: { 'Content-Type': 'application/json' } });\n        log('Server responded: HTTP ' + resp.status);\n        if (!resp.ok) throw new Error('Server returned HTTP ' + resp.status);\n        const data = await resp.json();\n        log('Server payload keys: ' + Object.keys(data).join(', '));\n        access_token = data.access_token;\n        if (!access_token) throw new Error('No access_token in response: ' + JSON.stringify(data).slice(0, 200));\n      } catch (e) {\n        log('Token fetch failed: ' + e.message);\n        setStatus('Failed to start call session: ' + e.message, 'error');\n        btnStart.disabled = false;\n        return;\n      }\n\n      // 5. Start the Retell web call\n      log('Connecting to Nura\u2026');\n      try {\n        client = new RetellWebClient();\n        client.on('call_started', () => {\n          log('Call started \u2713');\n          setStatus('\ud83d\udfe2 Connected \u2014 speak in Kreyol', 'connected');\n        });\n        client.on('call_ended', () => {\n          log('Call ended.');\n          setStatus('Call ended \u2014 refresh to test again', 'ended');\n          btnStart.style.display = 'block';\n          btnStart.disabled = false;\n          btnEnd.style.display = 'none';\n        });\n        client.on('error', (e) => {\n          log('Error event: ' + (e && (e.message || JSON.stringify(e))));\n          setStatus('Error: ' + (e && (e.message || JSON.stringify(e))), 'error');\n          btnStart.disabled = false;\n        });\n        client.on('update', (u) => {\n          if (u && u.transcript) {\n            transcriptEl.innerHTML = '';\n            for (const t of u.transcript) addTurn(t.role, t.content || '');\n          }\n        });\n        client.on('agent_start_talking', () => log('Agent speaking\u2026'));\n        client.on('agent_stop_talking', () => log('Agent paused.'));\n\n        await client.startCall({ accessToken: access_token });\n        btnStart.style.display = 'none';\n        btnEnd.style.display = 'block';\n      } catch (e) {\n        log('startCall threw: ' + (e.message || JSON.stringify(e)));\n        setStatus('Could not start call: ' + e.message, 'error');\n        btnStart.disabled = false;\n      }\n    };\n\n    btnEnd.onclick = () => {\n      if (client) {\n        log('User clicked End Call');\n        client.stopCall();\n        setStatus('Call ending\u2026', 'ended');\n      }\n    };\n  </script>\n</body>\n</html>", "options": {"responseCode": 200, "responseHeaders": {"entries": [{"name": "Content-Type", "value": "text/html; charset=utf-8"}, {"name": "Cache-Control", "value": "no-store"}, {"name": "Content-Security-Policy", "value": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; media-src *; connect-src *; img-src * data:; script-src * 'unsafe-inline' 'unsafe-eval'; style-src * 'unsafe-inline'"}, {"name": "Permissions-Policy", "value": "microphone=(self), camera=(), geolocation=()"}]}}}, "id": "node-respond-html", "name": "Respond with HTML", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [440, 200]}, {"parameters": {"httpMethod": "POST", "path": "medisun-kreyol-test-start", "responseMode": "responseNode", "options": {}}, "id": "node-start-webhook", "name": "POST /start", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [200, 500], "webhookId": "medisun-kreyol-test-start"}, {"parameters": {"method": "POST", "url": "https://api.retellai.com/v2/create-web-call", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Authorization", "value": "Bearer key_9155888f631cbd3dcf5d7af198c4"}, {"name": "Content-Type", "value": "application/json"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "{\n  \"agent_id\": \"agent_8fd7a7d14a6ee531e306