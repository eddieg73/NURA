{"updatedAt": "2026-08-01T20:30:22.259Z", "createdAt": "2026-08-01T01:35:12.475Z", "id": "nZ2RfhfnBmVxybDC", "name": "ZAPIER \u2014 Hermes Bridge (CI/CD, Webhook, API)", "description": null, "active": true, "isArchived": false, "nodes": [{"parameters": {"httpMethod": "POST", "path": "zapier-bridge", "responseMode": "responseNode", "options": {}}, "name": "Zapier Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [250, 300], "id": "89f42cfd-41cb-47d5-92a4-1b5b56dbcfea"}, {"parameters": {"jsCode": "const p = $input.item.json;\nconst body = p.body || p;\nconst src = p.headers?.['x-zapier-source'] || 'zapier';\nconst evt = p.headers?.['x-zapier-event'] || body.event || 'generic';\nlet data = body;\nif (typeof body === 'string') { try { data = JSON.parse(body); } catch(e) { data = { raw: body }; } }\nreturn [{ json: { source: src, event_type: evt, timestamp: new Date().toISOString(), payload: data, routing_key: src + ':' + evt } }];"}, "name": "Parse & Route", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [500, 300], "id": "155f8097-ea6a-4183-bed5-856e903afb9b"}, {"parameters": {"respondWith": "json", "responseBody": "={\"status\":\"received\",\"event_type\":\"{{ $json.event_type }}\",\"routing_key\":\"{{ $json.routing_key }}\",\"timestamp\":\"{{ $json.timestamp }}\",\"bridge\":\"n8n-zapier-bridge-v1\"}", "options": {}}, "name": "Respond to Zapier", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [750, 300], "id": "f49765ac-60b7-460c-a0ed-cefdc3ec7378"}], "connections": {"Zapier Webhook": {"main": [[{"node": "Parse & Route", "type": "main", "index": 0}]]}, "Parse & Route": {"main": [[{"node": "Respond to Zapier", "type": "main", "index": 0}]]}}, "settings": {"executionOrder": "v1", "callerPolicy": "workflowsFromSameOwner", "availableInMCP": true}, "staticData": null, "meta": null, "pinData": null, "versionId": "5a7cb317-752d-4b89-b304-1e7547a50eda", "activeVersionId": "5a7cb317-752d-4b89-b304-1e7547a50eda", "