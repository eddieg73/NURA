{"updatedAt": "2026-08-01T20:29:21.629Z", "createdAt": "2026-07-27T01:46:27.629Z", "id": "kscK7O2bxgOBiRT0", "name": "OpenEMR \u2014 Insurance Eligibility Verification", "description": null, "active": false, "isArchived": false, "nodes": [{"name": "Eligibility Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2.1, "position": [240, 360], "parameters": {"httpMethod": "POST", "path": "openemr-eligibility-check", "responseMode": "responseNode", "options": {}}, "id": "6ad101f4-27f7-4300-9c09-537f566bc730"}, {"name": "Normalize Eligibility Request", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [460, 360], "parameters": {"jsCode": "const b = $json.body || $json;\nconst patientId = String(b.patient_id || b.patientId || '').trim();\nconst coverageId = String(b.coverage_id || b.coverageId || '').trim();\nconst memberId = String(b.member_id || b.memberId || '').trim();\nconst payer = String(b.payer || b.payer_name || '').trim();\nconst serviceDate = String(b.service_date || b.serviceDate || new Date().toISOString().slice(0, 10)).trim();\nconst ok = Boolean(patientId && (coverageId || memberId || payer));\nreturn [{ json: { ok, patientId, coverageId, memberId, payer, serviceDate, baseUrl: ($env.OPENEMR_BASE_URL || 'https://emr.hrthouse.com').replace(/\\/$/, ''), siteId: $env.OPENEMR_SITE_ID || 'default', token: $env.OPENEMR_ACCESS_TOKEN || '', eligibilityWebhook: $env.ELIGIBILITY_QUEUE_WEBHOOK_URL || '', auditWebhook: $env.AUDIT_WEBHOOK_URL || '' } }];"}, "id": "76b06eb0-6799-414a-99eb-54f27bf8b5c9"}, {"name": "Eligibility Request Valid?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [680, 360], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"}, "conditions": [{"id": "c1", "leftValue": "={{ $json.ok }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}}, "id": "39e3da0e-a505-479b-a8b3-35e0a1261fe2"}, {"name": "Fetch Patient Context", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [900, 240], "parameters": {"method": "GET", "url": "={{ $json.baseUrl + '/apis/' + $json.siteId + '/fhir/Patient/' + encodeURIComponent($json.patientId) }}", "authentication": "none", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Accept", "value": "application/fhir+json"}, {"name": "Content-Type", "value": "application/fhir+json"}, {"name": "Authorization", "value": "={{ 'Bearer ' + $json.token }}"}]}, "options": {}}, "id": "fdbac66c-bd28-49c4-8b59-43a870170971"}, {"name": "Build Eligibility Packet", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1120, 240], "parameters": {"jsCode": "const ctx = $('Normalize Eligibility Request').item.json;\nconst patient = $json || {};\nconst patientName = Array.isArray(patient.name) && patient.name.length ? [patient.name[0]?.given?.join(' '), patient.name[0]?.family].filter(Boolean).join(' ').trim() : ctx.patientId;\nreturn [{ json: { ...ctx, patient_name: patientName, eligibilityPacket: { patient_id: ctx.patientId, patient_name: patientName, coverage_id: ctx.coverageId, member_id: ctx.memberId, payer: ctx.payer, service_date: ctx.serviceDate, source: 'OpenEMR n8n eligibility verification' }, summary: `Eligibility request prepared for ${patientName} (${ctx.payer || ctx.coverageId || ctx.memberId})` } }];"}, "id": "bf89805f-1b8e-400a-8c1d-aeafc0abea7a"}, {"name": "Send Eligibility Request", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [1340, 240], "parameters": {"method": "POST", "url": "={{ $json.eligibilityWebhook }}", "authentication": "none", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify($json.eligibilityPacket) }}", "options": {}}, "id": "af757370-35a8-4c30-a24a-ea389e07a585"}, {"name": "Audit Eligibility", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [1560, 240], "parameters": {"method": "POST", "url": "={{ $json.auditWebhook }}", "authentication": "none", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ workflow: 'OpenEMR \u2014 Insurance Eligibility Verification', patient_id: $json.patientId, payer: $json.payer, coverage_id: $json.coverageId, status: 'queued' }) }}", "options": {}}, "id": "0e75a516-9de2-4a07-b8ae-3bee56c186bc"}, {"name": "Respond Eligibility Routed", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [1780, 240], "parameters": {"respondWith": "json", "responseBody": "={{ JSON.stringify($json) }}", "options": {"responseHeaders": {"entries": [{"name": "Content-Type", "value": "application/json"}]}}}, "id": "04e714eb-d7f4-4160-a3be-e552cd906e50"}, {"name": "Invalid Eligibility Request", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [900, 520], "parameters": {"jsCode": "return [{ json: { ok: false, status: 'invalid_request', message: 'Need patient_id and one of coverage_id, member_id, or payer.' } }];"}, "id": "be7f6166-6ab6-4628-93f0-0efe85c28e06"}, {"name": "Respond Invalid Eligibility", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [1120, 520], "parameters": {"respondWith": "json", "responseBody": "={{ JSON.stringify($json) }}", "options": {"responseHeaders": {"entries": [{"name": "Content-Type", "value": "application/json"}]}}}, "id": "89093eb0-5a8b-4c80-87be-778b3513eac7"}], "connections": {"Eligibility Webhook": {"main": [[{"node": "Normalize Eligibility Request", "type": "main", "index": 0}]]}, "Normalize Eligibility Request": {"main": [[{"node": "Eligibility Request Valid?", "type": "main", "index": 0}]]}, "Eligibility Request Valid?": {"main": [[{"node": "Fetch Patient Context", "type": "main", "index": 0}], [{"node": "Invalid Eligibility Request", "type": "main", "index": 0}]]}, "Fetch Patient Context": {"main": [[{"node": "Build Eligibility Packet", "type": "main", "index": 0}]]}, "Build Eligibility Packet": {"main": [[{"node": "Send Eligibility Request