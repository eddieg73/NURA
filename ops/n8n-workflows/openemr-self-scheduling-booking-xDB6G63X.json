{"updatedAt": "2026-08-01T20:29:18.237Z", "createdAt": "2026-07-27T01:46:27.456Z", "id": "xDB6G63XDM59ZR6f", "name": "OpenEMR \u2014 Self-Scheduling & Booking", "description": null, "active": false, "isArchived": false, "nodes": [{"name": "Self-Schedule Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2.1, "position": [240, 360], "parameters": {"httpMethod": "POST", "path": "openemr-self-schedule", "responseMode": "responseNode", "options": {}}, "id": "52435741-6dd7-4324-9c34-8ee1d2987ba5"}, {"name": "Normalize Booking Request", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [460, 360], "parameters": {"jsCode": "const b = $json.body || $json;\nconst patientId = String(b.patient_id || b.patientId || '').trim();\nconst practitionerId = String(b.practitioner_id || b.practitionerId || '').trim();\nconst start = String(b.start_time || b.startTime || '').trim();\nconst end = String(b.end_time || b.endTime || '').trim();\nconst reason = String(b.reason || b.reason_for_visit || 'Patient requested booking').trim();\nconst consent = b.consent !== undefined ? Boolean(b.consent) : true;\nconst ok = Boolean(patientId && start && end);\nreturn [{ json: { ok, patientId, practitionerId, start, end, reason, consent, baseUrl: ($env.OPENEMR_BASE_URL || 'https://emr.hrthouse.com').replace(/\\/$/, ''), siteId: $env.OPENEMR_SITE_ID || 'default', token: $env.OPENEMR_ACCESS_TOKEN || '', notifyWebhook: $env.NOTIFICATION_WEBHOOK_URL || '', auditWebhook: $env.AUDIT_WEBHOOK_URL || '' } }];"}, "id": "6fece568-a289-44e7-b3ba-abadb641ab20"}, {"name": "Booking Request Valid?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [680, 360], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"}, "conditions": [{"id": "c1", "leftValue": "={{ $json.ok }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}}, "id": "2238ee3d-9b18-4034-90cf-3f5faf47c24c"}, {"name": "Build Appointment Resource", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [900, 240], "parameters": {"jsCode": "const ctx = $json;\nconst appointment = {\n  resourceType: 'Appointment',\n  status: 'booked',\n  start: ctx.start,\n  end: ctx.end,\n  participant: [\n    { actor: { reference: `Patient/${ctx.patientId}` }, status: 'accepted' },\n    ...(ctx.practitionerId ? [{ actor: { reference: `Practitioner/${ctx.practitionerId}` }, status: 'accepted' }] : [])\n  ],\n  reasonCode: [{ text: ctx.reason }],\n  comment: 'Created via n8n self-scheduling workflow'\n};\nreturn [{ json: { ...ctx, appointment, confirmationText: `Appointment request created for ${ctx.patientId} from ${ctx.start} to ${ctx.end}.`, bookingWebhook: ctx.notifyWebhook, auditWebhook: ctx.auditWebhook } }];"}, "id": "e939f0cb-d299-48ee-ad06-172599a337e6"}, {"name": "Create Appointment", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [1120, 240], "parameters": {"method": "POST", "url": "={{ $json.baseUrl + '/apis/' + $json.siteId + '/fhir/Appointment' }}", "authentication": "none", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Accept", "value": "application/fhir+json"}, {"name": "Content-Type", "value": "application/fhir+json"}, {"name": "Authorization", "value": "={{ 'Bearer ' + $json.token }}"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify($json.appointment) }}", "options": {}}, "id": "9f6dccdb-0f83-466d-9d26-ff77815fa634"}, {"name": "Send Confirmation", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [1340, 240], "parameters": {"method": "POST", "url": "={{ $json.bookingWebhook }}", "authentication": "none", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ channel: 'booking-confirmation', patient_id: $json.patientId, practitioner_id: $json.practitionerId, start: $json.start, end: $json.end, reason: $json.reason, message: $json.confirmationText }) }}", "options": {}}, "id": "20346118-d0b8-442d-9947-9d90314eb396"}, {"name": "Audit Booking", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [1560, 240], "parameters": {"method": "POST", "url": "={{ $json.auditWebhook }}", "authentication": "none", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ workflow: 'OpenEMR \u2014 Self-Scheduling & Booking', patient_id: $json.patientId, practitioner_id: $json.practitionerId, start: $json.start, end: $json.end, status: 'booked' }) }}", "options": {}}, "id": "c347e828-b7af-4934-8372-40edade2853a"}, {"name": "Invalid Booking Request", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [900, 520], "parameters": {"jsCode": "return [{ json: { ok: false, status: 'invalid_request', message: 'Need patient_id, start_time, and end_time.' } }];"}, "id": "9de03095-3b5d-4731-8efd-013a73bf8449"}, {"name": "Respond Invalid Booking", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [1120, 520], "parameters": {"respondWith": "json", "responseBody": "={{ JSON.stringify($json) }}", "options": {"responseHeaders": {"entries": [{"name": "Content-Type", "value": "application/json"}]}}}, "id": "e3c6224a-ac71-4b4c-9955-3e1f2fd7f22b"}, {"name": "Respond Booking Created", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [1780, 240], "parameters": {"respondWith": "json", "responseBody": "={{ JSON.stringify($json) }}", "options": {"responseHeaders": {"entries": [{"name": "Content-Type", "value": "application/json"}]}}}, "id": "fedc7b9d-610b-4960-9f61-bc30b5277565"}], "connections": {"Self-Schedule Webhook": {"main": [[{"node": "Normalize Booking Request", "type": "main", "index": 0}]]}, "Normalize Booking Request": {"main": [[{"node": "Booking Request Valid?", "type": "main", "index": 0}]]}, "Booking Request Valid?": {"main": [[{"node": "Build Appointment Resource", "type": "main", "index": 0}], [{"node": "Invalid Booking Request", "t