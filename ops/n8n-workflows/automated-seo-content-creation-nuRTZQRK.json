{"updatedAt": "2026-08-01T20:29:35.774Z", "createdAt": "2026-07-27T02:13:50.346Z", "id": "nuRTZQRKIZ2TvmHg", "name": "Automated SEO Content Creation", "description": null, "active": false, "isArchived": false, "nodes": [{"parameters": {}, "id": "manual-trigger", "name": "Manual Trigger", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [40, 300]}, {"parameters": {"authentication": "oAuth2", "sheetId": "your_google_sheet_id_here", "range": "Campaigns!A2:D100", "options": {"valueRenderMode": "UNFORMATTED_VALUE"}}, "id": "read-campaign-input", "name": "Read Campaign Input", "type": "n8n-nodes-base.googleSheets", "typeVersion": 1, "position": [220, 300], "credentials": {"googleSheetsOAuth2Api": {"id": "1nO2mksCA5HYuwr4", "name": "Google Sheets account"}}}, {"parameters": {"jsCode": "return items.map((item, index) => { const row = item.json || {}; const description = row.Description || row.description || row.Campaign || row.campaign || row.Topic || row.topic || ''; const targetTone = row.targetTone || row.TargetTone || row.Tone || 'professional'; const targetAudience = row.targetAudience || row.TargetAudience || row.Audience || 'marketing readers'; const sourceRowNumber = row.row_number || row.rowNumber || row.Row || row.row || (index + 2); return { json: { ...row, source_row_number: sourceRowNumber, campaign_description: description, targetTone, targetAudience } }; }).filter(item => String(item.json.campaign_description || '').trim().length > 0);"}, "id": "prepare-campaign-rows", "name": "Prepare Campaign Rows", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [420, 300]}, {"parameters": {"jsCode": "return items.map((item) => ({ json: { ...item.json, query: `Google search for: ${item.json.campaign_description || ''}` } }));"}, "id": "generate-search-query", "name": "Generate Search Query", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [640, 300]}, {"parameters": {"url": "https://serpapi.com/search.json", "sendQuery": true, "queryParameters": {"parameters": [{"name": "q", "value": "={{ $json.query }}"}, {"name": "api_key", "value": "={{ $env.SERPAPI_API_KEY }}"}]}, "responseFormat": "json", "options": {}}, "id": "fetch-keywords-serpapi", "name": "Fetch Keywords from SerpAPI", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [860, 300]}, {"parameters": {"jsCode": "return items.map((item) => { const data = item.json || {}; const candidates = []; for (const result of (data.organic_results || [])) { if (result.title) candidates.push(result.title); if (result.snippet) candidates.push(result.snippet); } for (const related of (data.related_searches || [])) { if (typeof related === 'string') candidates.push(related); else if (related && related.query) candidates.push(related.query); else if (related && related.name) candidates.push(related.name); } const keywords = [...new Set(candidates.map(v => String(v).trim()).filter(Boolean))]; const groupedKeywords = keywords.reduce((acc, k, i) => { const group = `Group ${Math.floor(i / 5) + 1}`; acc[group] = acc[group] || []; acc[group].push(k); return acc; }, {}); return { json: { ...data, groupedKeywords, keywordList: keywords } }; });"}, "id": "normalize-keywords", "name": "Normalize Keywords", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1080, 300]}, {"parameters": {"prompt": "Create an SEO article draft using these grouped keywords: {{$json.groupedKeywords}}. Campaign: {{$node[\"Prepare Campaign Rows\"].json[\"campaign_description\"]}}. Tone: {{$node[\"Prepare Campaign Rows\"].json[\"targetTone\"]}}. Audience: {{$node[\"Prepare Campaign Rows\"].json[\"targetAudience\"]}}. Return the draft only, with no preamble.", "model": "gpt-4o", "temperature": 0.7}, "id": "generate-article-openai", "name": "Generate Article with GPT-4o", "type": "n8n-nodes-base.openAi", "typeVersion": 1, "position": [1300, 300], "credentials": {"openAiApi": {"id": "oJly4Fi7jL4ZtE4Y", "name": "OpenAi account"}}}, {"parameters": {"jsCode": "return items.map((item) => { const j = item.json || {}; const preferred = [j.text, j.content, j.output, j.response, j.message && j.message.content, j.result]; let article = preferred.find((v) => typeof v === 'string' && v.trim()); if (!article) { article = Object.values(j).find((v) => typeof v === 'string' && v.trim().length > 40); } if (!article) { article = JSON.stringify(j); } return { json: { ...j, article, generated_at: new Date().toISOString() } }; });"}, "id": "normalize-article-output", "name": "Normalize Article Output", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1510, 300]}, {"parameters": {"mode": "combine", "combineBy": "combineByPosition", "numberInputs": 2, "options": {}}, "id": "merge-row-article", "name": "Merge Row + Article", "type": "n8n-nodes-base.merge", "typeVersion": 3.2, "position": [1730, 300]}, {"parameters": {"jsCode": "return items.map((item) => { const j = item.json || {}; return { json: { source_row_number: j.source_row_number, campaign_description: j.campaign_description, targetTone: j.targetTone, targetAudience: j.targetAudience, query: j.query, grouped_keywords: JSON.stringify(j.groupedKeywords || {}), keyword_count: Array.isArray(j.keywordList) ? j.keywordList.length : 0, article: j.article, generated_at: j.generated_at } }; });"}, "id": "build-output-row", "name": "Build Output Row", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1950, 300]}, {"parameters": {"operation": "append", "documentId": {"__rl": true, "mode": "list", "value": "your_google_sheet_id_here", "cachedResultName": "SEO Content Output", "cachedResultUrl": ""}, "sheetName": {"__rl": true, "mode": "list", "value": "gid=0", "cachedResultName": "GeneratedContent", "cachedResultUrl": ""}, "columns": {"mappingMode": "defineBelow", "value": {"source_row_number": "={{ $json.source_row_number }}", "campaign_description": "={{ $json.campaign_description }}", "targetTone": "={{ $json.targetTone }}", "targetAudience": "={{ $json.targetAudience