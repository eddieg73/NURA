{"updatedAt": "2026-08-01T20:29:59.935Z", "createdAt": "2026-07-31T20:34:23.696Z", "id": "Urhr64FTPHpnLxsL", "name": "ASC - Pre-Op Clearance & Checklist", "description": null, "active": false, "isArchived": false, "nodes": [{"parameters": {"rule": {"interval": [{"field": "hours", "hoursInterval": 6}]}}, "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.1, "position": [-400, 0], "id": "a1af50ed-f598-4986-8a32-f5bbd71e59d7", "name": "Every 6 Hours"}, {"parameters": {"method": "POST", "url": "=http://127.0.0.1:8642/v1/chat/completions", "sendBody": true, "bodyParameters": {"parameters": []}, "options": {}}, "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-160, 0], "id": "05c1e297-8e82-48eb-ad5f-3ca1a0ffba55", "name": "Fetch Surgeries (OpenEMR)"}, {"parameters": {"jsCode": "const surgeries = $input.all();\nconst now = new Date();\nreturn surgeries.map(s => ({json: s.json}));"}, "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [80, 0], "id": "de6fe64d-be3e-46e1-a278-fecc7f2b8497", "name": "Filter Pre-Op Windows"}, {"parameters": {"text": "=You are a surgical pre-op coordinator. Generate a personalized pre-operative checklist.\n\nPATIENT: {{ $json.patientName }}\nPROCEDURE: {{ $json.procedure }}\nSURGEON: {{ $json.surgeon }}\nDATE: {{ $json.date }} at {{ $json.time }}\n\nInclude: NPO instructions, medications to hold/continue, arrival time, what to bring, what to wear, red flag symptoms requiring immediate contact. Add confirmation button text: 'I have read and understand these instructions.'"}, "type": "@n8n/n8n-nodes-langchain.chainLlm", "typeVersion": 1.4, "position": [320, 0], "id": "09b1493a-33e4-4277-b788-26ca0a5a9fa5", "name": "AI - Generate Checklist"}, {"parameters": {"method": "POST", "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage", "sendBody": true, "bodyParameters": {"parameters": [{"name": "chat_id", "value": "={{ $json.patientTelegramId }}"}, {"name": "text", "value": "={{ $json.output || $json.text }}"}, {"name": "parse_mode", "value": "HTML"}]}}, "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [560, 0], "id": "1e6c4adb-867b-4b0d-bf30-fdb1a859d7b9", "name": "Send via Telegram"}], "connections": {"Every 6 Hours": {"main": [[{"node": "Fetch Surgeries (OpenEMR)", "type": "main", "index": 0}]]}, "Fetch Surgeries (OpenEMR)": {"main": [[{"node": "Filter Pre-Op Windows", "type": "main", "index": 0}]]}, "Filter Pre-Op Windows": {"main": [[{"node": "AI - Generate Checklist", "type": "main", "index": 0}]]}}, "settings": {"executionOrder": "v1", "callerPolicy": "workflowsFromSameOwner", "availableInMCP": true}, "staticData": null, "meta": null, "pinData": null, "versionId": "527b8feb-23f5-46ab-977e-149389a02883", "activeVersionId": null, "versionCounter": 2, "triggerCount": 0, "shared": [{"updatedAt": "2026-07-31T20:34:23.696Z", "createdAt": "2026-07-31T20:34:23.696Z", "role": "workflow:owner", "workflowId": "Urhr64FTPHpnLxsL", "projectId": "wI1MZESjf1ci46dZ", "project": {"updatedAt": "2025-09-26T11:09:32.827Z", "createdAt": "2025-09-26T10:27:30.749Z", "id": "wI1MZESjf1ci46dZ", "name": "Web Master <webmaster@clearwateraesthetics.com>", "type": "personal", "icon": null, "description": null, "creatorId": "cc65b1b6-5043-4d07-81dd-eeefb2f0d0a0"}}], "tags": [], "activeVersion": null}