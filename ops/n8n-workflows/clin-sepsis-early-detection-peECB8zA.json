{"updatedAt": "2026-08-01T20:30:13.676Z", "createdAt": "2026-08-01T00:27:15.965Z", "id": "peECB8zAOMVgbxV6", "name": "CLIN - Sepsis Early Detection", "description": null, "active": false, "isArchived": false, "nodes": [{"parameters": {"rule": {"interval": [{"field": "minutes", "minutesInterval": 15}]}}, "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.1, "position": [-400, 0], "id": "585dbec9-efc5-446c-b52e-d7857b5d91e5", "name": "Every 15 Minutes"}, {"parameters": {"method": "POST", "url": "=http://127.0.0.1:8642/v1/chat/completions", "sendBody": true, "bodyParameters": {"parameters": [{"name": "action", "value": "fetch_inpatient_vitals"}]}}, "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-160, 0], "id": "37f0f0be-ea9e-4960-8fd2-bfe83c955ae6", "name": "Fetch Inpatient Vitals"}, {"parameters": {"jsCode": "const patients = $input.all();\nlet alerts = [];\nfor (const p of patients) {\n  const v = p.json;\n  let sirs = 0;\n  if (v.temp && (v.temp > 38 || v.temp < 36)) sirs++;\n  if (v.hr && v.hr > 90) sirs++;\n  if (v.rr && v.rr > 20) sirs++;\n  if (v.wbc && (v.wbc > 12000 || v.wbc < 4000)) sirs++;\n  if (sirs >= 2) alerts.push({json: {...v, sirs_count: sirs, alert: 'SIRS ' + sirs + '/4'}});\n}\nreturn alerts.length ? alerts : [{json: {status: 'no_alerts'}}];"}, "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [80, 0], "id": "d750340a-2974-4b93-9d74-c9ca3ee89460", "name": "SIRS Screening"}, {"parameters": {"text": "=SIRS Alert: {{ $json.sirs_count }}/4 criteria met.\nPatient: {{ $json.patient_name }}\nRoom: {{ $json.room }}\nTemp: {{ $json.temp }} | HR: {{ $json.hr }} | RR: {{ $json.rr }} | WBC: {{ $json.wbc }}\n\nAssess for sepsis. If suspected infection + SIRS \u22652, initiate sepsis protocol immediately.\n\n\u26a0 CLINICIAN ACTION REQUIRED"}, "type": "@n8n/n8n-nodes-langchain.chainLlm", "typeVersion": 1.4, "position": [320, -80], "id": "aa6bdeb2-2540-4cd5-ae30-b4cd48febaaa", "name": "AI - Sepsis Assessment"}, {"parameters": {"method": "POST", "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage", "sendBody": true, "bodyParameters": {"parameters": [{"name": "chat_id", "value": "=294478354"}, {"name": "text", "value": "={{ $json.output || 'SEPSIS ALERT' }}"}, {"name": "parse_mode", "value": "HTML"}]}}, "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [560, -80], "id": "13bd42ce-2e14-419f-9b7e-111da32e4dd6", "name": "Alert Care Team"}], "connections": {"Every 15 Minutes": {"main": [[{"node": "Fetch Inpatient Vitals", "type": "main", "index": 0}]]}, "Fetch Inpatient Vitals": {"main": [[{"node": "SIRS Screening", "type": "main", "index": 0}]]}, "SIRS Screening": {"main": [[{"node": "AI - Sepsis Assessment", "type": "main", "index": 0}]]}, "AI - Sepsis Assessment": {"main": [[{"node": "Alert Care Team", "type": "main", "index": 0}]]}}, "settings": {"executionOrder": "v1", "callerPolicy": "workflowsFromSameOwner", "availableInMCP": true}, "staticData": null, "meta": null, "pinData": null, "versionId": "ceb17635-bc97-4652-8a5e-7ae679b8daae", "activeVersionId": null, "versionCounter": 2, "triggerCount": 0, "shared": [{"updatedAt": "2026-08-01T00:27:15.965Z", "createdAt": "2026-08-01T00:27:15.965Z", "role": "workflow:owner", "workflowId": "peECB8zAOMVgbxV6", "projectId": "wI1MZESjf1ci46dZ", "project": {"updatedAt": "2025-09-26T11:09:32.827Z", "createdAt": "2025-09-26T10:27:30.749Z", "id": "wI1MZESjf1ci46dZ", "name": "Web Master <webmaster@clearwateraesthetics.com>", "type": "personal", "icon": null, "description": null, "creatorId": "cc65b1b6-5043-4d07-81dd-eeefb2f0d0a0"}}], "tags": [], "activeVersion": null}