dyParameters": {"parameters": [{"name": "chat_id", "value": "={{ $json.providerChatId || '294478354' }}"}, {"name": "text", "value": "={{ $json.output || $json.text }}"}, {"name": "parse_mode", "value": "HTML"}]}}, "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [560, 0], "id": "af844fd2-b654-4c7e-b87a-70898d28a571", "name": "Deliver to Provider"}], "connections": {"CDS Query": {"main": [[{"node": "Parse Query", "type": "main", "index": 0}]]}, "Parse Query": {"main": [[{"node": "Fetch Patient (OpenEMR)", "type": "main", "index": 0}]]}, "Fetch Patient (OpenEMR)": {"main": [[{"node": "AI - Clinical Reasoning", "type": "main", "index": 0}]]}, "AI - Clinical Reasoning": {"main": [[{"node": "Deliver to Provider", "type": "main", "index": 0}]]}}, "settings": {"executionOrder": "v1", "callerPolicy": "workflowsFromSameOwner", "availableInMCP": true}, "staticData": null, "meta": null, "pinData": null, "versionId": "bdc3c417-aebd-4426-a011-b49a2ac38cde", "activeVersionId": null, "versionCounter": 2, "triggerCount": 0, "shared": [{"updatedAt": "2026-08-01T00:27:15.896Z", "createdAt": "2026-08-01T00:27:15.896Z", "role": "workflow:owner", "workflowId": "Dy3ZbbgxxbketwRW", "projectId": "wI1MZESjf1ci46dZ", "project": {"updatedAt": "2025-09-26T11:09:32.827Z", "createdAt": "2025-09-26T10:27:30.749Z", "id": "wI1MZESjf1ci46dZ", "name": "Web Master <webmaster@clearwateraesthetics.com>", "type": "personal", "icon": null, "description": null, "creatorId": "cc65b1b6-5043-4d07-81dd-eeefb2f0d0a0"}}], "tags": [], "activeVersion": null}