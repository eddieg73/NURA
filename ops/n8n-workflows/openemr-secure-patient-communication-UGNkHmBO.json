{"updatedAt": "2026-08-01T20:29:14.873Z", "createdAt": "2026-07-27T01:43:19.734Z", "id": "UGNkHmBO1BKjyEKQ", "name": "OpenEMR \u2014 Secure Patient Communication", "description": null, "active": false, "isArchived": false, "nodes": [{"name": "Result Dispatch Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2.1, "position": [240, 460], "parameters": {"httpMethod": "POST", "path": "openemr-result-dispatch", "responseMode": "responseNode", "options": {}}, "id": "9550761b-8f3a-4ac3-91e3-d7ba679f3bc5"}, {"name": "Normalize Result Event", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [460, 460], "parameters": {"jsCode": "const b = $json.body || $json;\nconst patientId = String(b.patient_id || b.patientId || '').trim();\nconst providerId = String(b.provider_id || b.providerId || '').trim();\nconst resultText = String(b.result_text || b.resultText || b.summary || '').trim();\nconst critical = Boolean(b.critical || b.isCritical);\nconst abnormal = Boolean(b.abnormal || b.isAbnormal);\nconst consent = b.consent !== undefined ? Boolean(b.consent) : true;\nconst ok = Boolean(patientId && resultText);\nreturn [{ json: { ok, patientId, providerId, resultText, critical, abnormal, consent, baseUrl: ($env.OPENEMR_BASE_URL || 'https://emr.hrthouse.com').replace(/\\/$/, ''), siteId: $env.OPENEMR_SITE_ID || 'default', token: $env.OPENEMR_ACCESS_TOKEN || '', patientWebhook: $env.SECURE_NOTIFICATION_WEBHOOK_URL || '', providerWebhook: $env.PROVIDER_ALERT_WEBHOOK_URL || '', auditWebhook: $env.AUDIT_WEBHOOK_URL || '' } }];"}, "id": "1e2ee442-86e8-4ac6-ae17-8bb5ae1370b0"}, {"name": "Result Event Valid?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [680, 460], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"}, "conditions": [{"id": "c1", "leftValue": "={{ $json.ok }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}}, "id": "7cb03b6b-4d5b-4c9c-8485-b359ca22d1c0"}, {"name": "Fetch Patient Context", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [900, 340], "parameters": {"method": "GET", "url": "={{ $json.baseUrl + '/apis/' + $json.siteId + '/fhir/Patient/' + encodeURIComponent($json.patientId) }}", "authentication": "none", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Accept", "value": "application/fhir+json"}, {"name": "Content-Type", "value": "application/fhir+json"}, {"name": "Authorization", "value": "={{ 'Bearer ' + $json.token }}"}]}, "options": {}}, "id": "aeed87f7-d0ed-4b8c-8bf7-349fd2a2606b"}, {"name": "Build Communication Plan", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1120, 340], "parameters": {"jsCode": "const ctx = $('Normalize Result Event').item.json;\nconst patient = $json || {};\nconst humanName = Array.isArray(patient.name) && patient.name.length ? [patient.name[0]?.given?.join(' '), patient.name[0]?.family].filter(Boolean).join(' ').trim() : ctx.patientId;\nconst sendPatient = ctx.consent !== false;\nconst sendProvider = Boolean(ctx.critical || ctx.abnormal);\nreturn [{ json: { ...ctx, patient_name: humanName, send_patient: sendPatient, send_provider: sendProvider, patient_message: `Lab result update for ${humanName}: ${ctx.resultText}`, provider_message: `Lab alert for ${humanName}: ${ctx.resultText}` } }];"}, "id": "0e0ff262-9adc-4f64-99d8-bfc5dc701819"}, {"name": "Send Patient Message?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1340, 340], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"}, "conditions": [{"id": "c1", "leftValue": "={{ $json.send_patient }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}}, "id": "e9ae800f-b29e-498d-8e85-a2caa11f64ab"}, {"name": "Send Patient Notification", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [1560, 240], "parameters": {"method": "POST", "url": "={{ $json.patientWebhook }}", "authentication": "none", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ channel: 'patient-result', patient_id: $json.patientId, patient_name: $json.patient_name, critical: $json.critical, abnormal: $json.abnormal, message: $json.patient_message }) }}", "options": {}}, "id": "d9eb71e9-f5d8-42a7-a8b6-04999d789d59"}, {"name": "Critical or Abnormal?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1780, 340], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"}, "conditions": [{"id": "c1", "leftValue": "={{ $json.send_provider }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}}, "id": "fa733dc0-fbc2-4a4f-9164-bdcb67b6b683"}, {"name": "Send Provider Alert", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [2000, 240], "parameters": {"method": "POST", "url": "={{ $json.providerWebhook }}", "authentication": "none", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ channel: 'provider-alert', provider_id: $json.providerId, patient_id: $json.patientId, patient_name: $json.patient_name, critical: $json.critical, abnormal: $json.abnormal, message: $json.provider_message }) }}", "options": {}}, "id": "0c65b2cc-9963-4cd5-b896-ecaf6b3b6fce"}, {"name": "Audit Communication", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [2220, 340], "parameters": {"method": "POST", "url": "={{ $json.auditWebhook }}", "authentication": "none", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ workflow: 'OpenEMR \u2014 Secure Patient Communication', patient_id: $json.patientId, provider_id: $json.providerId, patient_name: $json.patient_name, critical: $json.critical, abnormal: $json.abnormal, status: 'dispatched' }) }}", "options": {}}, "id": "a55365d2-a6ae-4e8a-9d81-d4b5b2673834"}, {"name": "Respond Communication Routed", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [2440, 340], "parameters": {"respondWith": "json", "responseBody": "={{ JSON.stringify($json) }}", "options": {"responseHeaders": {"entries": [{"name": "Content-Type", "value": "application/json"}]}}}, "id": "c7c4d62d-8895-4edf-a767-e32be7b0d8c6"}, {"name": "Invalid Result Event", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [900, 620], "parameters": {"jsCode": "return [{ json: { ok: false, status: 'invalid_request', message: 'Need patient_id and result_text at minimum.' } }];"}, "id": "a160678e-874b-4b07-873f-2d6dab78a9f8"}, {"name": "Respond Invalid Result", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [1120, 620], "parameters": {"respondWith": "json", "responseBody": "={{ JSON.stringify($json) }}", "options": {"responseHeaders": {"entries": [{"name": "Content-Type", "value": "application/json"}]}}}, "id": "87b96d21-f9b5-49c1-a4a8-c5f199188862"}], "connections": {"Result Dispatch Webhook": {"main": [[{"node": "Normalize Result Event", "type": "main", "index": 0}]]}, "Normalize Result Event": {"main": [[{"node": "Result Event Valid?", "type": "main", "index": 0}]]}, "Result Event Valid?": {"main": [[{"node": "Fetch Patient Context", "type": "main", "index": 0}], [{"node": "Invalid Result Event", "type": "main", "index": 0}]]}, "Fetch Patient Context": {"main": [[{"node": "Build Communication Plan", "type": "main", "index": 0}]]}, "Build Communication Plan": {"main": [[{"node": "Send Patient Message?", "type": "main", "index": 0}], [{"node": "Critical or Abnormal?", "type": "main", "index": 0}]]}, "Send Patient Message?": {"main": [[{"node": "Send Patient Notification", "type": "main", "index": 0}], [{"node": "Critical or Abnormal?", "type": "main", "index": 0}]]}, "Send Patient Notification": {"main": [[{"node": "Critical or Abnor