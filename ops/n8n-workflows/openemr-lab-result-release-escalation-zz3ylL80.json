{"updatedAt": "2026-08-01T20:29:32.049Z", "createdAt": "2026-07-27T01:46:27.826Z", "id": "zz3ylL80Awp6GyeY", "name": "OpenEMR \u2014 Lab Result Release & Escalation", "description": null, "active": false, "isArchived": false, "nodes": [{"name": "Lab Result Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2.1, "position": [240, 360], "parameters": {"httpMethod": "POST", "path": "openemr-lab-result", "responseMode": "responseNode", "options": {}}, "id": "e002af1b-4380-4555-97c0-54455ec939fa"}, {"name": "Normalize Lab Result", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [460, 360], "parameters": {"jsCode": "const b = $json.body || $json;\nconst patientId = String(b.patient_id || b.patientId || '').trim();\nconst providerId = String(b.provider_id || b.providerId || '').trim();\nconst resultText = String(b.result_text || b.resultText || '').trim();\nconst critical = Boolean(b.critical || b.isCritical);\nconst abnormal = Boolean(b.abnormal || b.isAbnormal);\nconst consent = b.consent !== undefined ? Boolean(b.consent) : true;\nconst ok = Boolean(patientId && resultText);\nreturn [{ json: { ok, patientId, providerId, resultText, critical, abnormal, consent, baseUrl: ($env.OPENEMR_BASE_URL || 'https://emr.hrthouse.com').replace(/\\/$/, ''), siteId: $env.OPENEMR_SITE_ID || 'default', token: $env.OPENEMR_ACCESS_TOKEN || '', patientWebhook: $env.SECURE_NOTIFICATION_WEBHOOK_URL || '', providerWebhook: $env.PROVIDER_ALERT_WEBHOOK_URL || '', auditWebhook: $env.AUDIT_WEBHOOK_URL || '' } }];"}, "id": "e7038530-be60-4191-aee4-de4af907d89e"}, {"name": "Lab Result Valid?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [680, 360], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"}, "conditions": [{"id": "c1", "leftValue": "={{ $json.ok }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}}, "id": "983a31c4-05b5-4666-891a-aac609687ebd"}, {"name": "Fetch Patient Context", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [900, 240], "parameters": {"method": "GET", "url": "={{ $json.baseUrl + '/apis/' + $json.siteId + '/fhir/Patient/' + encodeURIComponent($json.patientId) }}", "authentication": "none", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Accept", "value": "application/fhir+json"}, {"name": "Content-Type", "value": "application/fhir+json"}, {"name": "Authorization", "value": "={{ 'Bearer ' + $json.token }}"}]}, "options": {}}, "id": "9735e79a-b8f1-479c-9515-b6e60e313768"}, {"name": "Build Lab Delivery Plan", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1120, 240], "parameters": {"jsCode": "const ctx = $('Normalize Lab Result').item.json;\nconst patient = $json || {};\nconst patientName = Array.isArray(patient.name) && patient.name.length ? [patient.name[0]?.given?.join(' '), patient.name[0]?.family].filter(Boolean).join(' ').trim() : ctx.patientId;\nreturn [{ json: { ...ctx, patient_name: patientName, send_patient: ctx.consent !== false, send_provider: Boolean(ctx.critical || ctx.abnormal), patient_message: `Lab result for ${patientName}: ${ctx.resultText}`, provider_message: `Lab result alert for ${patientName}: ${ctx.resultText}` } }];"}, "id": "fda5a80c-af2b-4e8a-912c-a96185ae4fd1"}, {"name": "Send Patient Result?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1340, 240], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"}, "conditions": [{"id": "c1", "leftValue": "={{ $json.send_patient }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}}, "id": "1356c1a4-ef2d-4366-abe8-5373309bced4"}, {"name": "Send Patient Lab Result", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [1560, 160], "parameters": {"method": "POST", "url": "={{