{"updatedAt": "2026-08-01T20:29:29.660Z", "createdAt": "2026-07-27T01:46:27.763Z", "id": "P1AHXiLpv4ZEVPoE", "name": "OpenEMR \u2014 Post-Visit Follow-Up & Education", "description": null, "active": false, "isArchived": false, "nodes": [{"name": "Follow-Up Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2.1, "position": [240, 360], "parameters": {"httpMethod": "POST", "path": "openemr-follow-up", "responseMode": "responseNode", "options": {}}, "id": "78e2c43d-5481-44fd-a29f-bfb7e0f54d1d"}, {"name": "Normalize Follow-Up Request", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [460, 360], "parameters": {"jsCode": "const b = $json.body || $json;\nconst patientId = String(b.patient_id || b.patientId || '').trim();\nconst encounterId = String(b.encounter_id || b.encounterId || '').trim();\nconst dischargeSummary = String(b.discharge_summary || b.dischargeSummary || '').trim();\nconst educationTopic = String(b.education_topic || b.educationTopic || 'Post-visit care instructions').trim();\nconst followUpDays = Number(b.follow_up_days || b.followUpDays || 3);\nconst consent = b.consent !== undefined ? Boolean(b.consent) : true;\nconst ok = Boolean(patientId && dischargeSummary);\nreturn [{ json: { ok, patientId, encounterId, dischargeSummary, educationTopic, followUpDays, consent, baseUrl: ($env.OPENEMR_BASE_URL || 'https://emr.hrthouse.com').replace(/\\/$/, ''), siteId: $env.OPENEMR_SITE_ID || 'default', token: $env.OPENEMR_ACCESS_TOKEN || '', educationWebhook: $env.SECURE_NOTIFICATION_WEBHOOK_URL || '', providerWebhook: $env.PROVIDER_ALERT_WEBHOOK_URL || '', auditWebhook: $env.AUDIT_WEBHOOK_URL || '' } }];"}, "id": "32b16c3d-f078-4cbe-af12-75cba0db1810"}, {"name": "Follow-Up Request Valid?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [680, 360], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"}, "conditions": [{"id": "c1", "leftValue": "={{ $json.ok }}", "rightValue": true,