eCode": 200}}, "id": "ef58d2ca-04ed-40ba-9f0a-724c4ef725c2", "name": "Respond: Booking Confirmed", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [592, 1040]}, {"parameters": {"respondWith": "json", "responseBody": "{\"success\": false, \"message\": \"There was an error booking the appointment. Please try again or contact us directly.\"}", "options": {"responseCode": 200}}, "id": "441b4841-b00f-4faf-aa8f-d4194052d5f9", "name": "Respond: Booking Failed", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [352, 1168]}, {"parameters": {"jsCode": "const calendarMap = {\n  'optometry':                  '09jWpMx9VfnVneRJJ3hH',\n  'neurostar tms consultation': 'GK0SPNPpbWlDd2WSssdD',\n  'primary care':               'QgpxEQxhIcKwY9F1zlL2',\n  'wound care':                 'QvBmapJzdn3Xeo7QeWjX',\n  'physical therapy':           'TcHXx9jVgCYtGylMS3Cx',\n  'neurostar tms treatment':    'XhEvK54D2UT65DDBt9EG',\n  'cardiology':                 'dXMOJcUILDFXohcQCMP8',\n  'psychiatry':                 'viyFxLzlyow8Wfcr8lk1',\n  'podiatry':                   'y7SSvE3b4vOTeNHhMVX8'\n};\n\nconst body = $input.first().json.body;\nconst service = (body.service || '').toLowerCase().trim();\nconst calendarId = calendarMap[service];\n\nif (!calendarId) {\n  throw new Error('Unknown service: ' + body.service + '. Valid: ' + Object.keys(calendarMap).join(', '));\n}\n\nconst startDate = new Date(body.startDate);\nstartDate.setHours(0, 0, 0, 0);\nconst endDate = new Date(body.endDate || body.startDate);\nendDate.setHours(23, 59, 59, 999);\n\nreturn [{ json: {\n  calendarId,\n  locationId: body.locationId,\n  startDate: startDate.getTime(),\n  endDate: endDate.getTime(),\n  timezone: body.timezone || 'America/New_York',\n  service: body.service\n}}];"}, "id": "b413c63b-9aba-403e-a68c-e5343dccb246", "name": "Resolve Calendar ID1", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-368, 800]}, {"parameters": {"jsCode": "const data = $input.first().json;\nconst dateKeys = Object.keys(data).filter(k => k !== 'traceId');\nconst allSlots = [];\n\nfor (const date of dateKeys) {\n  const slots = (data[date] && data[date].slots) ? data[date].slots : [];\n  allSlots.push(...slots);\n}\n\n// Parse hour directly from ISO string offset time (already in EST -05:00)\nconst getHour = (slot) => parseInt(slot.split('T')[1].split(':')[0]);\n\n// Categorize based on actual time in the slot string\nconst earlyMorning = allSlots.filter(s => getHour(s) >= 8  && getHour(s) < 11);  // 8am - 10:45am\nconst midday       = allSlots.filter(s => getHour(s) >= 11 && getHour(s) < 14);  // 11am - 1:45pm\nconst afternoon    = allSlots.filter(s => getHour(s) >= 14 && getHour(s) <= 17); // 2pm - 5pm\n\n// Pick 1 from each category\nconst selected = [];\nif (earlyMorning.length > 0) selected.push(earlyMorning[0]);\nif (midday.length > 0)       selected.push(midday[0]);\nif (afternoon.length > 0)    selected.push(afternoon[0]);\n\n// Fill to 3 if any category was empty\nconst remaining = allSlots.filter(s => !selected.includes(s));\nfor (const slot of remaining) {\n  if (selected.length >= 3) break;\n  selected.push(slot);\n}\n\n// Format to readable\nconst formatted = selected.slice(0, 3).map(slot => {\n  const d = new Date(slot);\n  const readable = d.toLocaleString('en-US', {\n    weekday: 'long',\n    month: 'long',\n    day: 'numeric',\n    hour: 'numeric',\n    minute: '2-digit',\n    hour12: true,\n    timeZone: 'America/New_York'\n  });\n  return { iso: slot, readable };\n});\n\nreturn [{ json: { slots: formatted, count: formatted.length } }];"}, "id": "42a58899-9613-444d-bd8f-57b66d4b6ed3", "name": "Format Slots1", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [112, 800]}, {"parameters": {"jsCode": "const calendarMap = {\n  'optometry':                  '09jWpMx9VfnVneRJJ3hH',\n  'neurostar tms consultation': 'GK0SPNPpbWlDd2WSssdD',\n  'primary care':               'QgpxEQxhIcKwY9F1zlL2',\n  'wound care':                 'QvBmapJzdn3Xeo7QeWjX',\n  'physical therapy':           'TcHXx9jVgCYtGylMS3Cx',\n  'neurostar tms treatment':    'XhEvK54D2UT65DDBt9EG',\n  'cardiology':                 'dXMOJcUILDFXohcQCMP8',\n  'psychiatry':                 'viyFxLzlyow8Wfcr8lk1',\n  'podiatry':                   'y7SSvE3b4vOTeNHhMVX8'\n};\n\nconst body = $input.first().json.body;\nconst service = (body.service || '').toLowerCase().trim();\nconst calendarId = calendarMap[service];\n\nif (!calendarId) {\n  throw new Error('Unknown service: ' + body.service);\n}\n\nconst startTime = body.startTime;\nconst endTime = body.endTime || new Date(new Date(startTime).getTime() + 30 * 60000).toISOString();\n\nreturn [{ json: {\n  calendarId,\n  locationId: body.locationId,\n  contactId: body.contactId,\n  startTime,\n  endTime,\n  service: body.service\n}}];"}, "id": "5cf97b50-8d6b-4d26-aa51-3e99a5867fa2", "name": "Resolve Calendar ID (Book)1", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-368, 1088]}], "connections": {"Webhook: Collect Caller Info": {"main": [[{"node": "GHL: Create or Update Contact", "type": "main", "index": 0}]]}, "GHL: Create or Update Contact": {"main": [[{"node": "IF: Contact Created?", "type": "main", "index": 0}]]}, "IF: Contact Created?": {"main": [[{"node": "Respond: Contact Saved", "type": "main", "index": 0}], [{"node": "Respond: Contact Failed", "type": "main", "index": 0}]]}, "Webhook: Check Availability": {"main": [[{"node": "Resolve Calendar ID1", "type": "main", "index": 0}]]}, "GHL: Get Free Slots": {"main": [[{"node": "Format Slots1", "type": "main", "index": 0}]]}, "IF: Slots Available?": {"main": [[{"node": "Respond: Slots Found", "type": "main", "index": 0}], [{"node": "Respond: No Slots", "type": "main", "index": 0}]]}, "Webhook: Book Appointment": {"main": [[{"node": "Resolve Calendar ID (Book)1", "type": "main", "index": 0}]]}, "GHL: Book Appointment": {"main": [[{"node": "IF: Booking Successful?", "type": "main", "index": 0}]]}, "IF