new file mode 100644
index 0000000..95c07b0
--- /dev/null
+++ b/src/data/aircraftSource.js
@@ -0,0 +1,66 @@
+/**
+ * Aircraft source selection — the single place that decides where live
+ * aircraft data comes from.
+ *
+ * Upstream defaulted to the OpenSky Network, whose terms restrict commercial
+ * use. NURA ships with a source-agnostic endpoint so the feed can be swapped
+ * by configuration rather than code, and so we can eventually own the data
+ * outright from a local receiver (no third party can revoke it).
+ *
+ * Modes:
+ *   own       — a self-hosted dump1090/readsb `aircraft.json` feed (default target).
+ *   adsb_lol  — the community adsb.lol aggregator. Default mode until a receiver exists.
+ *   opensky   — OpenSky Network. Non-commercial / development only.
+ */
+
+/** Client-facing endpoint that resolves the configured source server-side. */
+export const AIRCRAFT_ENDPOINT = '/api/aircraft';
+
+export const AIRCRAFT_SOURCE_MODES = Object.freeze(['own', 'adsb_lol', 'opensky']);
+
+/** Default mode. adsb.lol carries no commercial restriction. */
+export const DEFAULT_AIRCRAFT_SOURCE_MODE = 'adsb_lol';
+
+/** Free, community-run ADS-B aggregator used until we own a receiver. */
+export const ADSB_LOL_ENDPOINT = 'https://api.adsb.lol/v2';
+
+/** Default local dump1090/readsb HTTP feed. */
+export const DEFAULT_OWN_RECEIVER_URL = 'http://127.0.0.1:8080/data/aircraft.json';
+
+/**
+ * Resolve the aircraft source mode from an environment bag, failing safe.
+ * An unrecognised value falls back to the default rather than to OpenSky:
+ * defaulting a commercial deployment onto a restricted source is the exact
+ * failure this module exists to prevent.
+ *
+ * @param {Record<string, string|undefined>} [env]
+ * @returns {'own'|'adsb_lol'|'opensky'}
+ */
+export function resolveAircraftSourceMode(env = {}) {
+  const raw = String(env.NURA_ADSB_MODE || '').trim().toLowerCase();
+  return AIRCRAFT_SOURCE_MODES.includes(raw) ? raw : DEFAULT_AIRCRAFT_SOURCE_MODE;
+}
+
+/**
+ * Resolve the own-receiver URL, rejecting anything that is not http(s).
+ *
+ * @param {Record<string, string|undefined>} [env]
+ * @returns {string}
+ */
+export function resolveOwnReceiverUrl(env = {}) {
+  const raw = String(env.NURA_ADSB_OWN_URL || '').trim();
+  if (!raw) return DEFAULT_OWN_RECEIVER_URL;
+  if (!/^https?:\/\//i.test(raw)) return DEFAULT_OWN_RECEIVER_URL;
+  return raw;
+}
+
+/**
+ * Whether the resolved mode may be served in a commercial deployment.
+ * OpenSky is explicitly not cleared for commercial use.
+ *
+ * @param {string} mode
+ * @returns {boolean}
+ */
+export function isCommerciallyCleared(mode) {
+  return resolveAircraftSourceMode({ NURA_ADSB_MODE: mode }) !== 'opensky';
+}
diff --git a/src/data/aircraftSource.test.mjs b/src/data/aircraftSource.test.mjs
new file mode 100644
index 0000000..6d35eb6
--- /dev/null
+++ b/src/data/aircraftSource.test.mjs
@@ -0,0 +1,65 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import {
+  AIRCRAFT_ENDPOINT,
+  DEFAULT_AIRCRAFT_SOURCE_MODE,
+  DEFAULT_OWN_RECEIVER_URL,
+  isCommerciallyCleared,
+  resolveAircraftSourceMode,
+  resolveOwnReceiverUrl,
+} from './aircraftSource.js';
+
+test('aircraft source defaults to a commercially cleared mode', () => {
+  const mode = resolveAircraftSourceMode({});
+  assert.equal(mode, DEFAULT_AIRCRAFT_SOURCE_MODE);
+  // The regression this guards: defaulting a commercial build onto OpenSky.
+  assert.notEqual(mode, 'opensky');
+  assert.equal(isCommerciallyCleared(mode), true);
+});
+
+test('aircraft source accepts every supported mode', () => {
+  for (const mode of ['own', 'adsb_lol', 'opensky']) {
+    assert.equal(resolveAircraftSourceMode({ NURA_ADSB_MODE: mode }), mode);
+  }
+});
+
+test('aircraft source normalises case and whitespace', () => {
+  assert.equal(resolveAircraftSourceMode({ NURA_ADSB_MODE: '  ADS_B_LOL  ' }), DEFAULT_AIRCRAFT_SOURCE_MODE);
+  assert.equal(resolveAircraftSourceMode({ NURA_ADSB_MODE: ' ADSB_LOL ' }), 'adsb_lol');
+  assert.equal(resolveAircraftSourceMode({ NURA_ADSB_MODE: ' Own ' }), 'own');
+});
+
+test('an unrecognised mode fails safe to the default, never to OpenSky', () => {
+  for (const bad of ['', 'nonsense', 'opensky-network', 'null', 'undefined']) {
+    const mode = resolveAircraftSourceMode({ NURA_ADSB_MODE: bad });
+    assert.equal(mode, DEFAULT_AIRCRAFT_SOURCE_MODE);
+    assert.notEqual(mode, 'opensky');
+  }
+});
+
+test('OpenSky is reported as not commercially cleared', () => {
+  assert.equal(isCommerciallyCleared('opensky'), false);
+  assert.equal(isCommerciallyCleared('adsb_lol'), true);
+  assert.equal(isCommerciallyCleared('own'), true);
+});
+
+test('own receiver URL defaults and validates scheme', () => {
+  assert.equal(resolveOwnReceiverUrl({}), DEFAULT_OWN_RECEIVER_URL);
+  assert.equal(
+    resolveOwnReceiverUrl({ NURA_ADSB_OWN_URL: 'http://10.0.0.5:8080/data/aircraft.json' }),
+    'http://10.0.0.5:8080/data/aircraft.json',
+  );
+  assert.equal(
+    resolveOwnReceiverUrl({ NURA_ADSB_OWN_URL: 'https://receiver.nura.local/aircraft.json' }),
+    'https://receiver.nura.local/aircraft.json',
+  );
+  // A non-http(s) value must not become a fetch target.
+  assert.equal(resolveOwnReceiverUrl({ NURA_ADSB_OWN_URL: 'file:///etc/passwd' }), DEFAULT_OWN_RECEIVER_URL);
+  assert.equal(resolveOwnReceiverUrl({ NURA_ADSB_OWN_URL: '   ' }), DEFAULT_OWN_RECEIVER_URL);
+});
+
+test('the client endpoint is the source-agnostic path, not OpenSky', () => {
+  assert.equal(AIRCRAFT_ENDPOINT, '/api/aircraft');
+  assert.ok(!AIRCRAFT_ENDPOINT.includes('opensky'));
+});
