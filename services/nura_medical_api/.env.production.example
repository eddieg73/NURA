APP_ENV=production
DATABASE_URL=postgresql+psycopg://nura_medical:REPLACE_DB_PASSWORD@db:5432/nura_medical
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ALLOWED_ORIGINS=https://app.nuratech.ai
ALLOW_SELF_REGISTRATION=false
