# Runtime
APP_ENV=development
DATABASE_URL=sqlite:///./nura_medical.db
APP_JWT_SECRET=replace-with-at-least-32-random-characters
APP_ALLOWED_ORIGINS=https://app.nuratech.ai
APP_ALLOW_SELF_REGISTRATION=false
APP_SEED_DEMO_DATA=true
APP_DEMO_CLINICIAN_EMAIL=reviewer@nuratech.ai
APP_DEMO_CLINICIAN_PASSWORD=ReplaceBeforeRelease123!
APP_ADMIN_EMAIL=admin@nuratech.ai
APP_ADMIN_PASSWORD=ReplaceBeforeRelease123!

# Clinical inference: disabled | hermes | openai
AI_PROVIDER=disabled
CLINICAL_ENGINE_URL=
CLINICAL_ENGINE_TOKEN=
CLINICAL_REQUEST_TIMEOUT_SECONDS=45

# OpenAI routing is blocked unless all approval controls are true.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_BAA_CONFIRMED=false
OPENAI_PHI_APPROVED=false

# Public legal/support destinations
PRIVACY_POLICY_URL=https://nuratech.ai/privacy
TERMS_URL=https://nuratech.ai/terms
SUPPORT_URL=https://nuratech.ai/support
EVIDENCE_AS_OF=2026-08-31

# Docker Compose PostgreSQL
POSTGRES_DB=nura_medical
POSTGRES_USER=nura_medical
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
API_PORT=8080
