# Generate both secrets with: openssl rand -hex 32
HERMES_WEBHOOK_SECRET=replace-with-64-hex-characters
HERMES_WEBHOOK_KEY_ID=primary
ADMIN_BEARER_TOKEN=replace-with-a-different-64-hex-token

EVENT_DB_PATH=/data/hermes-events.sqlite3
MAX_BODY_BYTES=262144
WEBHOOK_MAX_AGE_SECONDS=300
REQUIRE_HTTPS=true
ENABLE_DOCS=false
ALLOWED_SOURCE_SERVICES=hermes-agent,paperclip,founderos

NOTION_ENABLED=false
NOTION_TOKEN=
NOTION_COORDINATION_DATA_SOURCE_ID=3cda9b14-e498-8127-a85e-000b87a4e359
NOTION_API_VERSION=2026-03-11
NOTION_TIMEOUT_SECONDS=10
SINK_EVENT_TYPES=nura.hermes.review.requested.v1,nura.hermes.status.updated.v1,nura.hermes.alert.raised.v1,nura.hermes.artifact.ready.v1
